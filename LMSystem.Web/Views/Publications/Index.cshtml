@model IEnumerable<LMSystem.Models.Publication>

@{
    string currentType = ViewData["CurrentType"]?.ToString() ?? "Newspaper";
    ViewData["Title"] = currentType + " Management";
    int pageNumber = (int?)ViewData["PageNumber"] ?? 1;
    int totalPages = (int?)ViewData["TotalPages"] ?? 1;
}

<div class="row mt-3">
    <!-- Banner -->
    <div class="col-12 mb-3">
        <div class="position-relative rounded-3 overflow-hidden shadow-sm">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTClMcQ7oX2QJz_0CIP_2NEzgZJd2O1UAqEUTgx66mVnA&s=10"
                 class="img-fluid w-100" alt="Publications" style="max-height: 200px; object-fit: cover;" />
            <div class="position-absolute top-0 start-0 w-100 h-100"
                 style="background: linear-gradient(90deg, rgba(0,0,0,0.6), rgba(0,0,0,0.2));">
                <div class="h-100 d-flex flex-column justify-content-center ps-4">
                    <h2 class="text-white fw-bold mb-1">@currentType Collection</h2>
                    <p class="text-light mb-0">
                        Browse and manage @currentType.ToLower() issues.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Top bar with actions + search -->
    <div class="col-12 mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Create" asp-route-type="@currentType" class="btn btn-primary">
                Add New @currentType
            </a>
            <form asp-action="Index" method="get" asp-route-type="@currentType" class="d-flex gap-2">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control"
                       placeholder="Search by title or publisher..." style="width: 260px;" />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                {
                    <a asp-action="Index" asp-route-type="@currentType" class="btn btn-link">Clear</a>
                }
            </form>
        </div>
    </div>

    <!-- Card + table -->
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">@currentType List</span>
                <span class="badge bg-secondary">@Model.Count() items</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Publisher</th>
                                <th>Published Date</th>
                                <th>Availability</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Title</td>
                                    <td>@item.Publisher</td>
                                    <td>@item.PublishedDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                                            @(item.IsAvailable ? "Available" : "Checked Out")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-warning">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger"
                                               onclick="return confirm('Delete this publication?');">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="card-footer bg-light">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == pageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-type="@currentType"
                                       asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-pageNumber="@i">
                                        @i
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>