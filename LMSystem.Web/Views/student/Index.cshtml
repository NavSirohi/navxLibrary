@model List<LMSystem.Models.StudentModel>

@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">

    <!-- Page header -->
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">Students</h2>
                <p class="text-muted mb-0">Manage registered students in the library system.</p>
            </div>
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-person-plus"></i> Add New Student
            </a>
        </div>
    </div>

    <!-- Card wrapper -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Student List</span>
            <span class="badge bg-secondary">
                @((Model?.Count ?? 0)) total
            </span>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 10%">ID</th>
                                <th style="width: 25%">Name</th>
                                <th style="width: 30%">Email</th>
                                <th style="width: 20%">Phone</th>
                                <th style="width: 15%" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.StudentId</td>
                                    <td>@item.StudentName</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@item.StudentId">
                                                Edit
                                            </a>
                                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.StudentId"
                                               onclick="return confirm('Are you sure you want to delete this student?');">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <h5 class="fw-semibold mb-2">No students found</h5>
                    <p class="mb-3">There are currently no students in the system. You can add one using the button above.
                    </p>
                    <a class="btn btn-outline-primary" asp-action="Create">
                        Add your first student
                    </a>
                </div>
            }
        </div>
    </div>

</div>