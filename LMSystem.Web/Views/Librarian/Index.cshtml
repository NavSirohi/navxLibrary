@model List<LMSystem.Models.LibrarianModel>

@{
    ViewData["Title"] = "Librarians";
}

<div class="container mt-4">

    <!-- Page header -->
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">Librarians</h2>
                <p class="text-muted mb-0">Manage staff members responsible for the library.</p>
            </div>
            <a class="btn btn-success" asp-action="Create">
                <i class="bi bi-person-badge"></i> Add New Librarian
            </a>
        </div>
    </div>

    <!-- Card wrapper -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Librarian List</span>
            <span class="badge bg-light text-primary">
                @((Model?.Count ?? 0)) total
            </span>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 10%">ID</th>
                                <th style="width: 30%">Name</th>
                                <th style="width: 15%">Age</th>
                                <th style="width: 25%">Phone</th>
                                <th style="width: 20%" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.LibrarianId</td>
                                    <td>@item.Name</td>
                                    <td>@item.Age</td>
                                    <td>@item.Phone</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a class="btn btn-outline-warning" asp-action="Edit"
                                               asp-route-id="@item.LibrarianId">
                                                Edit
                                            </a>
                                            <a class="btn btn-outline-danger" asp-action="Delete"
                                               asp-route-id="@item.LibrarianId"
                                               onclick="return confirm('Are you sure you want to delete this librarian?');">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <h5 class="fw-semibold mb-2">No librarians found</h5>
                    <p class="mb-3">There are currently no librarians in the system. Use the button above to add a staff
                        member.</p>
                        <a class="btn btn-outline-success" asp-action="Create">
                            Add your first librarian
                        </a>
                    </div>
                }
            </div>
        </div>

    </div>