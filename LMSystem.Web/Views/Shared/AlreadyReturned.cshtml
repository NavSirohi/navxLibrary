@{
    ViewData["Title"] = "Book Already Returned";
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="container text-center mt-5">
    <h1 class="display-4 text-info">Book Already Returned</h1>
    <p class="lead">
        @(string.IsNullOrEmpty(errorMessage)
            ? "The borrow record for this book has already been returned."
            : errorMessage)
    </p>
    <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Back to Book List</a>
</div>