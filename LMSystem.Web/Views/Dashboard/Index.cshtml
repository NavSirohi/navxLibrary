@model LMSystem.Models.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

@if (TempData["message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mt-3">

    <!-- Banner with logged-in info -->
    <div class="col-12 mb-4">
        <div class="position-relative rounded-3 overflow-hidden shadow-sm">
            <img src="~/images/dashboard-banner.jpg" class="img-fluid w-100" alt="Dashboard"
                 style="max-height: 220px; object-fit: cover;" />
            <div class="position-absolute top-0 start-0 w-100 h-100"
                 style="background: linear-gradient(90deg, rgba(0,0,0,0.7), rgba(0,0,0,0.2));">
                <div class="h-100 d-flex flex-column justify-content-center ps-4">
                    <h2 class="text-white fw-bold mb-1">Admin Dashboard</h2>
                    <p class="text-light mb-2">
                        Overview of students, books, librarians, and borrowing activity.
                    </p>
                    @if (ViewBag.LoggedInUser != null)
                    {
                        <p class="text-light mb-0">
                            Logged in as <strong>@ViewBag.LoggedInUser</strong> (@ViewBag.LoggedInRole)
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick actions -->
    <div class="col-12 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex flex-wrap gap-2">
                <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary">
                    Manage Books
                </a>
                <a asp-controller="Student" asp-action="Index" class="btn btn-outline-primary">
                    Manage Students
                </a>
                <a asp-controller="Librarian" asp-action="Index" class="btn btn-outline-primary">
                    Manage Librarians
                </a>
                <a asp-controller="Publications" asp-action="Index" asp-route-type="Newspaper"
                   class="btn btn-outline-primary">
                    View Publications
                </a>
                <a asp-controller="Borrow" asp-action="Index" class="btn btn-outline-primary">
                    Borrow Records
                </a>
            </div>
        </div>
    </div>

    <!-- Stat cards -->
    <div class="col-12">
        <div class="row g-4">

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-white" style="background-color: #4e73df;">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        <div>
                            <h6 class="text-uppercase fw-semibold opacity-75 mb-1">Total Students</h6>
                            <h2 class="display-6 fw-bold mb-0">@Model.TotalStudents</h2>
                        </div>
                        <p class="small mt-3 mb-0 opacity-75">Registered student profiles in the system.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-white" style="background-color: #1cc88a;">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        <div>
                            <h6 class="text-uppercase fw-semibold opacity-75 mb-1">Total Books</h6>
                            <h2 class="display-6 fw-bold mb-0">@Model.TotalBooks</h2>
                        </div>
                        <p class="small mt-3 mb-0 opacity-75">Books currently stored in the catalog.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-white" style="background-color: #36b9cc;">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        <div>
                            <h6 class="text-uppercase fw-semibold opacity-75 mb-1">Total Librarians</h6>
                            <h2 class="display-6 fw-bold mb-0">@Model.TotalLibrarians</h2>
                        </div>
                        <p class="small mt-3 mb-0 opacity-75">Staff members managing the library.</p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-white" style="background-color: #f6c23e;">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        <div>
                            <h6 class="text-uppercase fw-semibold opacity-75 mb-1">Total Borrowings</h6>
                            <h2 class="display-6 fw-bold mb-0">@Model.TotalBorrowings</h2>
                        </div>
                        <p class="small mt-3 mb-0 opacity-75">Total borrow records logged in the system.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>