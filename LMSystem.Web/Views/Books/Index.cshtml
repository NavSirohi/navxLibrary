@model LMSystem.Models.BookListViewModel

@{
    ViewData["Title"] = "Books";
}

<div class="row mt-3">

    <!-- Banner -->
    <div class="col-12 mb-3">
        <div class="position-relative rounded-3 overflow-hidden shadow-sm">
            <img src="data:image/jpeg;base64,"
                 class="img-fluid w-100" alt="Books" style="max-height: 220px; object-fit: cover;" />
            <div class="position-absolute top-0 start-0 w-100 h-100"
                 style="background: linear-gradient(90deg, rgba(0,0,0,0.6), rgba(0,0,0,0.1));">
                <div class="h-100 d-flex flex-column justify-content-center ps-4">
                    <h2 class="text-white fw-bold mb-1">Books Collection</h2>
                    <p class="text-light mb-2">Browse, search, and manage all books in the library.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions + search -->
    <div class="col-12 mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Create" class="btn btn-primary">
                Add New Book
            </a>
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control"
                       placeholder="Search by title, author, ISBN..." style="width: 260px;" />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a asp-action="Index" class="btn btn-link">Clear</a>
                }
            </form>
        </div>
    </div>

    <!-- Books card + table -->
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Books List</span>
                <span class="badge bg-secondary">
                    @Model.Books.Count() items
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>ISBN</th>
                                <th>Published Date</th>
                                <th>Availability</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model.Books)
                            {
                                <tr>
                                    <td>@book.Title</td>
                                    <td>@book.Author</td>
                                    <td>@book.ISBN</td>
                                    <td>@book.PublishedDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (book.IsAvailable)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Borrowed</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@book.BookId"
                                               class="btn btn-outline-info">Details</a>
                                            <a asp-action="Edit" asp-route-id="@book.BookId"
                                               class="btn btn-outline-warning">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@book.BookId"
                                               class="btn btn-outline-danger"
                                               onclick="return confirm('Delete this book?');">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-light">
                    <nav>
                        <ul class="pagination justify-content-center mb-0">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                       asp-route-searchQuery="@Model.SearchQuery">
                                        @i
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>