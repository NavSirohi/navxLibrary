@{
    ViewData["Title"] = "About Us";
}

<div class="row mt-4">
    <div class="col-md-6">
        <h2 class="fw-bold mb-3">About Our Library System</h2>
        <p class="text-muted">
            This Library Management System simplifies how librarians, students,
            and administrators interact with books, borrowing, and publications.
        </p>
        <p class="text-muted">
            With modules for books, students, librarians, borrowing, and publications,
            everything is accessible from one modern, responsive interface.
        </p>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <img src="~/images/about.jpg" class="card-img-top" alt="Library interior"
                 style="height: 220px; object-fit: cover;" />
            <div class="card-body">
                <h5 class="fw-semibold">Our Mission</h5>
                <p class="text-muted">
                    Provide a seamless, beautiful experience for managing all aspects of a library,
                    from book inventory to user access and analytics.
                </p>
            </div>
        </div>
    </div>
</div>